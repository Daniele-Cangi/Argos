# Public read-only endpoints. No trading credentials belong in this repository.
ARGOS_GAMMA_BASE_URL=https://gamma-api.polymarket.com
ARGOS_DATA_BASE_URL=https://data-api.polymarket.com
ARGOS_CLOB_BASE_URL=https://clob.polymarket.com
ARGOS_CLOB_MARKET_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
ARGOS_DATA_DIR=.data
ARGOS_LOG_LEVEL=INFO

# Explicitly disabled by design during M0-M4.
ARGOS_EXECUTION_ENABLED=false
